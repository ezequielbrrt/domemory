+/**
+ * Flippo, the living-card mascot, as the win/lose hero visual (see
+ * `.proposals/app-pet-flippo-modals/README.md`). A soft tinted panel echoes the mockups'
+ * lavender hero backdrop using an existing palette token rather than a new one; the three
+ * finished poses (win / lose-time / lose-mistakes) are pre-scaled and positioned
+ * consistently against each other, so this composable only has to place one image per
+ * outcome — no per-pose cropping or offsetting.
+ */
+@Composable
+private fun FlippoHero(@androidx.annotation.DrawableRes drawableRes: Int, modifier: Modifier = Modifier) {
+    val palette = LocalPalette.current
+    Box(
+        modifier = modifier
+            .fillMaxWidth()
+            .height(148.dp)
+            .clip(RoundedCornerShape(20.dp))
+            .background(palette.surfaceSecondary),
+        contentAlignment = Alignment.Center,
+    ) {
+        Image(
+            painter = painterResource(drawableRes),
+            contentDescription = null,
+            contentScale = ContentScale.Fit,
+            modifier = Modifier.fillMaxSize().padding(10.dp),
+        )
+    }
+}
