<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested on API 33+ via feature/notifications/NotificationPermission.kt;
         implicitly granted below API 33, where this declaration is a no-op (spec 11.2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- API 30+ package-visibility: lets the "Rate DoMemory" Settings row's market://
         intent (feature/settings/SettingsScreen.kt) resolve to the real Play Store app. -->
    <queries>
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".DoMemoryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/common_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoMemory">

        <!-- Registered Android AdMob app ID. Unit IDs remain code-configured by placement. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4297174845441653~9801529431" />

        <!-- Lets Play services prefetch the permission-less QR scanning module for Play installs. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DoMemory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- domemory://daily (Phase 5) and domemory://join/CODE (Phase 6). singleTop above
                 so a link tapped while the app is already
                 running reaches MainActivity.onNewIntent instead of stacking a new instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="domemory" />
            </intent-filter>

            <!-- The parser already accepts https://domemory.app/join/CODE and /daily.
                 autoVerify takes effect once the O1 assetlinks.json association is hosted. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="domemory.app" />
            </intent-filter>
        </activity>

        <!-- Daily Challenge home-screen widget (spec 8.1). The launcher owns the widget
             host, so this receiver must be exported for the system to deliver its update
             broadcasts. Its AppWidget provider metadata limits it to that contract. -->
        <receiver
            android:name=".widget.DailyChallengeWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_challenge_widget_info" />
        </receiver>
    </application>
</manifest>
