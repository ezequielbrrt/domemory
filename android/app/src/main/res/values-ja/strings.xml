    <!-- What's New v3.0.0 (retired content, still in the catalog) -->
    <string name="whats_new_multiplayer_title">マルチプレイヤー</string>
    <string name="whats_new_multiplayer_description">友達とリアルタイムで対戦 — ルームを作成して6桁のコードかQRコードを共有し、より多くのペアを見つけよう。</string>
    <string name="whats_new_reminders_title">プレイリマインダー</string>
    <string name="whats_new_reminders_description">数日間プレイしていないと通知が届き、脳トレを継続できます。</string>
    <string name="whats_new_theme_title">ライト＆ダークモード</string>
    <string name="whats_new_theme_description">設定からシステム・ライト・ダークを選んでお好みの外観にカスタマイズできます。</string>
    <string name="whats_new_hint_title">ヒント</string>
    <string name="whats_new_hint_description">行き詰まったら？一時停止して短い広告を見ると、隠れたカードのペアが1組明かされます。</string>
    <string name="whats_new_games_title">遊べるゲームが増えました</string>
    <string name="whats_new_games_description">あらゆる難易度に数十種類の新しい絵文字カードセットを追加。マスターすべきメモラマは130以上。</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">レベル</string>
    <string name="whats_new_levels_description">まったく新しい無限モード。レベルをクリアすると次が解放され、盤面は大きく、制限時間は短くなっていきます。</string>
    <string name="whats_new_stars_title">スター評価</string>
    <string name="whats_new_stars_description">速くミスなくクリアすると各レベルで最大3つのスターを獲得。何度でも挑戦してスコアを更新できます。</string>
    <string name="whats_new_powerups_title">パワーアップ</string>
    <string name="whats_new_powerups_description">スターを使って、時間の追加、盤面のちら見、時間停止、ペア1組の無料公開が可能です。</string>
    <string name="whats_new_lives_title">ライフとミス</string>
    <string name="whats_new_lives_description">ライフは1日4個、各レベルで許されるミスの数も決まっています。なくなったら広告を見るか、スターを使って続行できます。</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">シーズンレベル</string>
    <string name="whats_new_seasons_description">ハロウィンシーズンのような期間限定シーズンをプレイしよう。専用の報酬が用意されたテーマ別レベルセットで、次のシーズンが始まるまで数週間プレイできます。</string>
    <string name="whats_new_season_artwork_title">シーズンアートワーク</string>
    <string name="whats_new_season_artwork_description">各シーズンはレベルマップに専用の背景とカードアートを追加するので、新しいシーズンはいつもそれらしい見た目になります。</string>
    <string name="whats_new_tap_to_play_title">タップしてプレイ</string>
    <string name="whats_new_tap_to_play_description">レベルマップは次に進む場所を示すように脈動するようになり、すべてのタイルがタップに反応します。</string>
    <string name="whats_new_season_progress_title">シーズンの進行状況</string>
    <string name="whats_new_season_progress_description">ライブの進行状況バーとカウントダウンで各シーズンの進み具合を確認。時間切れになる前にすべてのレベルをクリアしよう。</string>

