    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Níveis</string>
    <string name="whats_new_levels_description">Um modo infinito totalmente novo. Complete um nível para desbloquear o próximo — os tabuleiros crescem e o relógio aperta.</string>
