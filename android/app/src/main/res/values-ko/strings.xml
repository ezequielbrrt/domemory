    <string name="whats_new_reminders_description">며칠 동안 플레이하지 않으면 알림을 보내드려 뇌 운동을 놓치지 않게 도와줍니다.</string>
    <string name="whats_new_theme_title">라이트 &amp; 다크 모드</string>
    <string name="whats_new_theme_description">설정에서 시스템, 라이트, 다크 중 원하는 외관을 선택하세요.</string>
    <string name="whats_new_hint_title">힌트</string>
    <string name="whats_new_hint_description">막혔나요? 게임을 일시 정지하고 짧은 광고를 보면 숨겨진 카드 한 쌍이 공개됩니다.</string>
    <string name="whats_new_games_title">더 많은 게임</string>
    <string name="whats_new_games_description">모든 난이도에 수십 개의 새로운 이모지 카드 세트 추가 — 마스터할 메모라마가 130개 이상.</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">레벨</string>
    <string name="whats_new_levels_description">완전히 새로운 무한 모드. 레벨을 클리어하면 다음이 열리고, 판은 커지고 시간은 촉박해집니다.</string>
    <string name="whats_new_stars_title">별 평가</string>
    <string name="whats_new_stars_description">빠르고 실수 없이 끝내면 레벨마다 최대 3개의 별을 얻습니다. 언제든 다시 도전해 점수를 올리세요.</string>
    <string name="whats_new_powerups_title">파워업</string>
    <string name="whats_new_powerups_description">게임 중 별을 사용해 시간 추가, 판 미리보기, 시간 정지, 무료 짝 공개를 쓸 수 있습니다.</string>
    <string name="whats_new_lives_title">목숨과 실수</string>
    <string name="whats_new_lives_description">하루 4개의 목숨이 주어지고, 레벨마다 허용되는 실수도 정해져 있습니다. 다 떨어지면 광고를 보거나 별을 쓰세요.</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">시즌 레벨</string>
    <string name="whats_new_seasons_description">스푸키 시즌 같은 기간 한정 시즌을 플레이하세요 — 전용 보상이 있는 테마별 레벨 세트로, 다음 시즌이 시작되기 전까지 몇 주간 진행됩니다.</string>
    <string name="whats_new_season_artwork_title">시즌 아트워크</string>
    <string name="whats_new_season_artwork_description">각 시즌마다 레벨 맵에 고유한 배경과 카드 아트가 추가되어 새로운 시즌마다 분위기가 달라집니다.</string>
    <string name="whats_new_tap_to_play_title">탭해서 플레이</string>
    <string name="whats_new_tap_to_play_description">레벨 맵이 이제 다음에 할 레벨을 알려주기 위해 맥동하며, 모든 타일이 탭에 반응합니다.</string>
    <string name="whats_new_season_progress_title">시즌 진행 상황</string>
    <string name="whats_new_season_progress_description">실시간 진행 바와 카운트다운으로 각 시즌의 진행 상황을 확인하세요 — 시간이 끝나기 전에 모든 레벨을 클리어하세요.</string>

