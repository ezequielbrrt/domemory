    <string name="whats_new_multiplayer_title">Multijugador</string>
    <string name="whats_new_multiplayer_description">Reta a un amigo en tiempo real — crea una sala, comparte un código de 6 dígitos o un QR y busca más pares que él.</string>
    <string name="whats_new_reminders_title">Recordatorios</string>
    <string name="whats_new_reminders_description">Recibe una notificación si no has jugado en un par de días para mantener tu mente activa.</string>
    <string name="whats_new_theme_title">Modo claro y oscuro</string>
    <string name="whats_new_theme_description">Elige Sistema, Claro u Oscuro en Ajustes para personalizar tu experiencia.</string>
    <string name="whats_new_hint_title">Pista</string>
    <string name="whats_new_hint_description">¿Atascado? Pausa el juego y mira un anuncio corto para revelar un par de cartas oculto.</string>
