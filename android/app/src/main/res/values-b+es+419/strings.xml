    <string name="whats_new_games_description">Decenas de nuevos sets de cartas con emojis en todas las dificultades: más de 130 memoramas para dominar.</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Niveles</string>
    <string name="whats_new_levels_description">Un modo infinito totalmente nuevo. Supera un nivel para desbloquear el siguiente: los tableros crecen y el reloj aprieta más.</string>
    <string name="whats_new_stars_title">Calificación por Estrellas</string>
    <string name="whats_new_stars_description">Termina rápido y sin fallos para ganar hasta 3 estrellas en cada nivel. Repite cualquier nivel para mejorar tu puntuación.</string>
    <string name="whats_new_powerups_title">Potenciadores</string>
    <string name="whats_new_powerups_description">Gasta tus estrellas durante la partida en tiempo extra, un vistazo al tablero, congelar el reloj o un par gratis.</string>
    <string name="whats_new_lives_title">Vidas y Errores</string>
    <string name="whats_new_lives_description">Tienes 4 vidas al día y cada nivel permite un número limitado de fallos. ¿Se te acabaron? Mira un anuncio o gasta estrellas para seguir.</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">Niveles de temporada</string>
    <string name="whats_new_seasons_description">Juega temporadas por tiempo limitado como la Temporada de Sustos: un conjunto temático de niveles con sus propias recompensas, disponible por unas semanas antes de que empiece la siguiente.</string>
    <string name="whats_new_season_artwork_title">Arte de temporada</string>
    <string name="whats_new_season_artwork_description">Cada temporada trae su propio fondo y arte de tarjeta al mapa de niveles, para que una temporada nueva siempre se vea distinta.</string>
    <string name="whats_new_tap_to_play_title">Toca para jugar</string>
    <string name="whats_new_tap_to_play_description">El mapa de niveles ahora pulsa para mostrarte cuál sigue, y cada casilla responde a tu toque.</string>
    <string name="whats_new_season_progress_title">Progreso de temporada</string>
    <string name="whats_new_season_progress_description">Sigue tu avance en cada temporada con una barra de progreso en vivo y una cuenta regresiva: completa todos los niveles antes de que se acabe el tiempo.</string>

