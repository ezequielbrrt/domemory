    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Niveaux</string>
    <string name="whats_new_levels_description">Un tout nouveau mode infini. Terminez un niveau pour débloquer le suivant : les plateaux s\'agrandissent et le chrono se resserre.</string>
    <string name="whats_new_stars_title">Notation par Étoiles</string>
    <string name="whats_new_stars_description">Terminez vite et sans faute pour gagner jusqu\'à 3 étoiles par niveau. Rejouez n\'importe quel niveau pour améliorer votre score.</string>
