    <string name="whats_new_multiplayer_title">मल्टीप्लेयर</string>
    <string name="whats_new_multiplayer_description">दोस्त को रियल-टाइम में चुनौती दें — कमरा बनाएं, 6-अंकीय कोड या QR साझा करें और अधिक जोड़े खोजें।</string>
    <string name="whats_new_reminders_title">खेल अनुस्मारक</string>
    <string name="whats_new_reminders_description">कुछ दिन न खेलने पर सूचना मिलेगी ताकि आपका दिमाग तेज़ बना रहे।</string>
    <string name="whats_new_theme_title">लाइट और डार्क मोड</string>
    <string name="whats_new_theme_description">सेटिंग्स में सिस्टम, लाइट या डार्क चुनकर अपनी पसंद के अनुसार ऐप का रूप बदलें।</string>
    <string name="whats_new_hint_title">संकेत</string>
    <string name="whats_new_hint_description">अटक गए? गेम रोकें और छोटा विज्ञापन देखें — एक छुपा हुआ जोड़ा सामने आ जाएगा।</string>
    <string name="whats_new_games_title">खेलने के लिए और भी गेम</string>
    <string name="whats_new_games_description">हर कठिनाई स्तर पर दर्जनों नए इमोजी कार्ड सेट — महारत हासिल करने के लिए 130 से ज़्यादा मेमोरमा।</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">स्तर</string>
    <string name="whats_new_levels_description">बिल्कुल नया अनंत मोड। अगला स्तर खोलने के लिए मौजूदा पूरा करें — बोर्ड बड़े होते जाते हैं और समय कम।</string>
    <string name="whats_new_stars_title">सितारा रेटिंग</string>
    <string name="whats_new_stars_description">तेज़ी से और बिना गलती पूरा करें और हर स्तर पर 3 तक सितारे कमाएँ। स्कोर सुधारने के लिए कोई भी स्तर दोबारा खेलें।</string>
    <string name="whats_new_powerups_title">पावर-अप</string>
    <string name="whats_new_powerups_description">खेल के दौरान सितारे खर्च करें — अतिरिक्त समय, बोर्ड की झलक, रुकी हुई घड़ी या एक मुफ़्त जोड़ी।</string>
    <string name="whats_new_lives_title">जीवन और गलतियाँ</string>
    <string name="whats_new_lives_description">हर दिन 4 जीवन मिलते हैं, और हर स्तर में सीमित गलतियाँ ही चलती हैं। खत्म हो गए? विज्ञापन देखें या सितारे खर्च करें।</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">सीज़न लेवल</string>
    <string name="whats_new_seasons_description">डरावना सीज़न जैसे सीमित समय के सीज़न खेलें — एक थीम वाला लेवल सेट जिसके अपने इनाम हैं, जो अगला शुरू होने से पहले कुछ हफ्तों तक चलता है।</string>
    <string name="whats_new_season_artwork_title">सीज़न आर्टवर्क</string>
    <string name="whats_new_season_artwork_description">हर सीज़न लेवल मैप पर अपना खुद का बैकग्राउंड और कार्ड आर्ट लाता है, ताकि नया सीज़न हमेशा अलग दिखे।</string>
    <string name="whats_new_tap_to_play_title">खेलने के लिए टैप करें</string>
    <string name="whats_new_tap_to_play_description">लेवल मैप अब यह दिखाने के लिए स्पंदित होता है कि आगे क्या है, और हर टाइल आपके टैप पर प्रतिक्रिया देती है।</string>
    <string name="whats_new_season_progress_title">सीज़न प्रगति</string>
    <string name="whats_new_season_progress_description">लाइव प्रोग्रेस बार और काउंटडाउन के साथ हर सीज़न में अपनी प्रगति ट्रैक करें — समय खत्म होने से पहले हर लेवल पूरा करें।</string>

