    <!-- What's New v3.0.0 (retired content, still in the catalog) -->
    <string name="whats_new_multiplayer_title">Mehrspieler</string>
    <string name="whats_new_multiplayer_description">Fordere einen Freund in Echtzeit heraus — erstelle einen Raum, teile den 6-stelligen Code oder QR-Code und finde mehr Paare.</string>
    <string name="whats_new_reminders_title">Spielerinnerungen</string>
    <string name="whats_new_reminders_description">Erhalte eine Erinnerung, wenn du ein paar Tage nicht gespielt hast, damit dein Gehirn fit bleibt.</string>
    <string name="whats_new_theme_title">Hell- und Dunkelmodus</string>
    <string name="whats_new_theme_description">Wähle System, Hell oder Dunkel in den Einstellungen nach deinem Geschmack.</string>
    <string name="whats_new_hint_title">Hinweis</string>
    <string name="whats_new_hint_description">Nicht weitergekommen? Pausiere das Spiel und sieh dir eine kurze Werbung an, um ein verstecktes Paar aufzudecken.</string>
    <string name="whats_new_games_title">Mehr Spiele zum Spielen</string>
    <string name="whats_new_games_description">Dutzende neue Emoji-Kartensets in allen Schwierigkeitsgraden – über 130 Memoramas zum Meistern.</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Level</string>
    <string name="whats_new_levels_description">Ein völlig neuer Endlosmodus. Schließe ein Level ab, um das nächste freizuschalten – die Felder werden größer, die Zeit knapper.</string>
    <string name="whats_new_stars_title">Sternewertung</string>
    <string name="whats_new_stars_description">Beende jedes Level schnell und fehlerfrei für bis zu 3 Sterne. Wiederhole Level jederzeit, um deine Wertung zu verbessern.</string>
    <string name="whats_new_powerups_title">Power-ups</string>
    <string name="whats_new_powerups_description">Gib deine Sterne im Spiel für Extrazeit, einen Blick aufs Feld, eine eingefrorene Uhr oder ein Gratis-Paar aus.</string>
    <string name="whats_new_lives_title">Leben &amp; Fehler</string>
    <string name="whats_new_lives_description">Du bekommst 4 Leben pro Tag, und jedes Level erlaubt nur eine begrenzte Zahl an Fehlern. Alles aufgebraucht? Sieh ein Video an oder gib Sterne aus.</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">Saison-Level</string>
    <string name="whats_new_seasons_description">Spiele zeitlich begrenzte Saisons wie die Gruselsaison – ein thematisches Level-Set mit eigenen Belohnungen, das ein paar Wochen läuft, bevor die nächste beginnt.</string>
    <string name="whats_new_season_artwork_title">Saison-Grafiken</string>
    <string name="whats_new_season_artwork_description">Jede Saison bringt ihren eigenen Hintergrund und ihre eigene Kartengrafik auf die Levelkarte, damit eine neue Saison immer passend aussieht.</string>
    <string name="whats_new_tap_to_play_title">Tippen zum Spielen</string>
    <string name="whats_new_tap_to_play_description">Die Levelkarte pulsiert jetzt, um dir zu zeigen, was als Nächstes kommt, und jedes Feld reagiert auf deinen Tipp.</string>
    <string name="whats_new_season_progress_title">Saisonfortschritt</string>
    <string name="whats_new_season_progress_description">Verfolge deinen Fortschritt in jeder Saison mit einer Live-Fortschrittsanzeige und einem Countdown – schließe jedes Level ab, bevor die Zeit abläuft.</string>

