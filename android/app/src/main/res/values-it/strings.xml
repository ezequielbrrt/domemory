    <!-- What's New v3.0.0 (retired content, still in the catalog) -->
    <string name="whats_new_multiplayer_title">Multiplayer</string>
    <string name="whats_new_multiplayer_description">Sfida un amico in tempo reale — crea una stanza, condividi il codice a 6 cifre o scansiona il QR e trova più coppie.</string>
    <string name="whats_new_reminders_title">Promemoria</string>
    <string name="whats_new_reminders_description">Ricevi una notifica se non hai giocato per qualche giorno, per tenere la mente allenata.</string>
    <string name="whats_new_theme_title">Modalità chiara e scura</string>
    <string name="whats_new_theme_description">Scegli Sistema, Chiaro o Scuro nelle Impostazioni in base ai tuoi gusti.</string>
    <string name="whats_new_hint_title">Suggerimento</string>
    <string name="whats_new_hint_description">Bloccato? Metti in pausa il gioco e guarda un breve annuncio per rivelare una coppia di carte nascosta.</string>
    <string name="whats_new_games_title">Più giochi da giocare</string>
    <string name="whats_new_games_description">Decine di nuovi set di carte emoji in tutte le difficoltà: oltre 130 memorama da padroneggiare.</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Livelli</string>
    <string name="whats_new_levels_description">Una modalità infinita tutta nuova. Completa un livello per sbloccare il successivo: i tabelloni crescono e il tempo si stringe.</string>
    <string name="whats_new_stars_title">Valutazione a Stelle</string>
    <string name="whats_new_stars_description">Finisci in fretta e senza errori per ottenere fino a 3 stelle a livello. Rigioca qualsiasi livello per migliorare il punteggio.</string>
    <string name="whats_new_powerups_title">Potenziamenti</string>
    <string name="whats_new_powerups_description">Spendi le stelle durante la partita per tempo extra, uno sguardo al tabellone, il tempo congelato o una coppia gratis.</string>
    <string name="whats_new_lives_title">Vite ed Errori</string>
    <string name="whats_new_lives_description">Hai 4 vite al giorno e ogni livello concede solo un certo numero di errori. Finiti? Guarda un annuncio o spendi stelle per continuare.</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">Livelli stagionali</string>
    <string name="whats_new_seasons_description">Gioca a stagioni a tempo limitato come la Stagione da Brivido — un set di livelli a tema con le proprie ricompense, disponibile per qualche settimana prima che inizi la successiva.</string>
    <string name="whats_new_season_artwork_title">Grafica stagionale</string>
    <string name="whats_new_season_artwork_description">Ogni stagione porta il proprio sfondo e la propria grafica delle carte sulla mappa dei livelli, così una nuova stagione ha sempre un aspetto diverso.</string>
    <string name="whats_new_tap_to_play_title">Tocca per giocare</string>
    <string name="whats_new_tap_to_play_description">La mappa dei livelli ora pulsa per mostrarti cosa viene dopo, e ogni riquadro risponde al tuo tocco.</string>
    <string name="whats_new_season_progress_title">Progressi stagionali</string>
    <string name="whats_new_season_progress_description">Segui i tuoi progressi in ogni stagione con una barra di avanzamento in tempo reale e un conto alla rovescia — completa ogni livello prima che scada il tempo.</string>

