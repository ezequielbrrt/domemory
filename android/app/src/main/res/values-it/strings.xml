    <!-- Levels intro -->
    <string name="levels_intro_progress_title">Livelli Infiniti</string>
    <string name="levels_intro_progress_subtitle">Completa un livello per sbloccare il successivo. I tabelloni crescono e il tempo si stringe: ce n\'è sempre un altro ad aspettarti.</string>
