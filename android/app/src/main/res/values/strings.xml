    <!-- What's New v3.0.0 (retired content, still in the catalog) -->
    <string name="whats_new_multiplayer_title">Multiplayer</string>
    <string name="whats_new_multiplayer_description">Challenge a friend in real-time — create a room, share a 6-digit code or QR scan, and race to find the most matching pairs.</string>
    <string name="whats_new_reminders_title">Play Reminders</string>
    <string name="whats_new_reminders_description">Get a nudge if you haven\'t played in a couple of days so your brain stays sharp.</string>
    <string name="whats_new_theme_title">Light &amp; Dark Mode</string>
    <string name="whats_new_theme_description">Choose System, Light, or Dark in Settings to match your style.</string>
    <string name="whats_new_hint_title">Hint</string>
    <string name="whats_new_hint_description">Stuck? Pause the game and watch a short ad to reveal one hidden pair of cards.</string>
    <string name="whats_new_games_title">More Games to Play</string>
    <string name="whats_new_games_description">Dozens of new emoji card sets across every difficulty — over 130 memoramas to master.</string>

    <!-- What's New v4.0.0 (retired content) -->
    <string name="whats_new_levels_title">Levels</string>
    <string name="whats_new_levels_description">A brand-new endless mode. Clear a level to unlock the next — boards keep growing and the clock keeps tightening.</string>
    <string name="whats_new_stars_title">Star Ratings</string>
    <string name="whats_new_stars_description">Finish fast and clean to earn up to 3 stars on every level. Replay any level to improve your score.</string>
    <string name="whats_new_powerups_title">Power-Ups</string>
    <string name="whats_new_powerups_description">Spend your stars mid-game on extra time, a peek at the board, a frozen clock, or a free matching pair.</string>
    <string name="whats_new_lives_title">Lives &amp; Mistakes</string>
    <string name="whats_new_lives_description">You get 4 lives a day, and every level allows only so many wrong matches. Out of either? Watch an ad or spend stars to keep going.</string>

    <!-- What's New v4.2.0 (current) -->
    <string name="whats_new_seasons_title">Season Levels</string>
    <string name="whats_new_seasons_description">Play limited-time seasons like Spooky Season — a themed set of levels with their own rewards, running for a few weeks before the next one begins.</string>
    <string name="whats_new_season_artwork_title">Themed Artwork</string>
    <string name="whats_new_season_artwork_description">Every season brings its own background and card art to the level map, so a new season always looks the part.</string>
    <string name="whats_new_tap_to_play_title">Tap to Play</string>
    <string name="whats_new_tap_to_play_description">The level map now pulses to show you what\'s next, and every tile responds to your tap.</string>
    <string name="whats_new_season_progress_title">Season Progress</string>
    <string name="whats_new_season_progress_description">Track your climb through each season with a live progress bar and countdown — clear every level before time runs out.</string>

